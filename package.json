{
  "name": "whisk",
  "version": "1.1.1",
  "type": "module",
  "description": "A personal recipe manager PWA — manage recipes, plan meals, build shopping lists, and use AI to discover new dishes.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsmedstad/whisk.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && npx wrangler pages deploy dist --project-name whisk --branch main --commit-dirty=true",
    "setup": "node scripts/setup.js",
    "import-csv": "bun scripts/import-csv.ts",
    "test": "bun test"
  },
  "dependencies": {
    "nanoid": "^5.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
